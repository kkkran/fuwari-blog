# 智谱开放平台 API Key（必填，从 https://open.bigmodel.cn 获取）
ZHIPU_API_KEY=your-api-key-here
# 主模型（可选，默认 glm-4.6v-flash，智谱最新视觉 Flash 模型）
# ZHIPU_MODEL=glm-4.6v-flash
# 回退模型（可选，逗号分隔；主模型限流/不可用时自动切换，默认 glm-4v-flash）
# ZHIPU_FALLBACK_MODELS=glm-4v-flash
# API 地址（可选，默认 https://open.bigmodel.cn/api/paas/v4）
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
