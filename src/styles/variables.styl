/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

:root
  --radius-large 0px
  --content-delay 150ms

/* An util to define variables */
define(vars)
  :root
    for key, value in vars
      {key}: value

define({
  /* ===== 2x.nz shadcn 语义 token（对齐 https://2x.nz 设计系统，暗色硬编码） ===== */
  --background: #171717
  --foreground: #e4e4e4
  --card: #1f1f1f
  --card-foreground: #e4e4e4
  --popover: #242424
  --popover-foreground: #e4e4e4
  --muted: #2e2e2e
  --muted-foreground: #a1a1a1
  --accent: #383838
  --accent-foreground: #e4e4e4
  --border: #404040
  --input: #4d4d4d
  --primary: #e4e4e4
  --primary-foreground: #171717
  --secondary: #2e2e2e
  --secondary-foreground: #e4e4e4
  --destructive: #e40014
  --ring: #85baff
  --tap: #85baff

  /* 布局 token */
  --site-shell-width: 72rem
  --header-height: 56px
  --card-spacing: 1rem

  /* ===== 本地兼容 token（映射到 2x.nz 值） ===== */
  --page-bg: var(--background)
  --card-bg: var(--card)
  --card-bg-transparent: rgba(31, 31, 31, 0.95)

  --btn-content: var(--foreground)
  --btn-regular-bg: #242424
  --btn-regular-bg-hover: #2e2e2e
  --btn-regular-bg-active: #383838
  --btn-plain-bg-hover: #242424
  --btn-plain-bg-active: #2e2e2e
  --btn-card-bg-hover: #242424
  --btn-card-bg-active: #2e2e2e
  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: var(--foreground)
  --title-active: #c8c8c8

  --line-divider: var(--border)
  --line-color: var(--border)
  --meta-divider: var(--muted-foreground)

  --inline-code-bg: #242424
  --inline-code-color: #e4e4e4
  --selection-bg: #383838
  --codeblock-selection: #242424
  --codeblock-bg: #1e1e2e
  --codeblock-topbar-bg: #181825

  --license-block-bg: var(--codeblock-bg)

  --link-underline: var(--foreground)
  --link-hover: #ffffff
  --link-active: var(--tap)

  --float-panel-bg: var(--popover)
  --float-panel-bg-transparent: rgba(36, 36, 36, 0.92)
  --float-panel-bg-opaque: var(--popover)

  --scrollbar-bg: var(--border)
  --scrollbar-bg-hover: #4d4d4d
  --scrollbar-bg-active: #525252

  --color-selection-bar: var(--foreground)

  --admonitions-color-note: oklch(0.85 0.12 250)
  --admonitions-color-important: oklch(0.85 0.12 310)
  --admonitions-color-warning: oklch(0.85 0.12 60)
  --admonitions-color-caution: oklch(0.75 0.12 25)
  --admonitions-color-ai: oklch(0.85 0.12 280)

  --toc-badge-bg: var(--btn-regular-bg)
  --toc-btn-hover: #242424
  --toc-btn-active: #383838
  --toc-width: clamp(11rem, calc((100vw - var(--page-width)) / 2 - 1rem), 22rem)
  --toc-item-active: #383838
})
