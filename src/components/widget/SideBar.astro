---
import type { MarkdownHeading } from "astro";

import {
	buildTimetableViewModel,
	resolveCurrentWeek,
} from "@/utils/timetable-normalizer";
import { parseTimetableFile } from "@/utils/timetable-parser-server";
import Icon from "@components/Icon.astro";
import LiveTimetableStatus from "@components/timetable/LiveTimetableStatus.astro";
import Profile from "./Profile.astro";

interface Props {
	headings?: MarkdownHeading[];
}

const timetableData = parseTimetableFile("src/data/timetable/大一下2.json");
const timetableWeek = resolveCurrentWeek(
	timetableData.meta.startDate,
	timetableData.meta.maxWeek,
);
const timetableViewModel = buildTimetableViewModel(
	timetableData,
	timetableWeek,
);
const sidebarLiveStatusPayload = {
	coursesByDay: timetableViewModel.coursesByDay,
};

const nookLinks = [
	{
		label: "写作归档",
		href: "/archive/",
		icon: "material-symbols:archive-outline-rounded",
	},
	{
		label: "工具实验",
		href: "/tools/",
		icon: "material-symbols:build-outline-rounded",
	},
	{
		label: "论坛广场",
		href: "/forum/",
		icon: "material-symbols:forum-outline-rounded",
	},
];
---

<div id="sidebar" class="w-full">
	<div class="mb-4 flex w-full flex-col gap-4">
		<Profile />
	</div>
	<div id="sidebar-sticky" class="sticky top-4 flex w-full flex-col gap-4" style="top: calc(var(--navbar-offset, 0px) + 1rem);">
		<div id="sidebar-timetable">
			<a href="/timetable/" class="block" aria-label="前往课程表">
				<LiveTimetableStatus payload={sidebarLiveStatusPayload} class="live-status-card" />
			</a>
		</div>

		<section class="card-base p-4">
			<div class="mb-3 flex items-center justify-between">
				<div>
					<div class="text-xs uppercase tracking-[0.16em] text-white/35">Nook Index</div>
					<h2 class="mt-1 text-base font-bold text-white/85">世界树栈索引</h2>
				</div>
				<div class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-[var(--primary)]">
					<Icon name="material-symbols:hub-outline-rounded" class="text-xl" />
				</div>
			</div>
			<div class="space-y-2">
				{nookLinks.map((item) => (
					<a href={item.href} class="group flex items-center justify-between rounded-lg border border-white/10 px-3 py-2 text-sm text-white/70 transition hover:border-[var(--primary)] hover:text-[var(--primary)] active:scale-[0.99]">
						<span class="flex items-center gap-2">
							<Icon name={item.icon} class="text-base" />
							{item.label}
						</span>
						<Icon name="material-symbols:arrow-forward-rounded" class="text-base opacity-45 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
					</a>
				))}
			</div>
		</section>
	</div>
</div>
