---
import type { MarkdownHeading } from "astro";

interface TocItem extends MarkdownHeading {
	children: TocItem[];
}

interface Props {
	items: TocItem[];
	level?: number;
}

const { items, level = 0 } = Astro.props;
---

{
	items.length > 0 && (
		level === 0 ? (
			<ol class="space-y-3">
				{items.map((item) => (
					<li>
						<a
							href={`#${item.slug}`}
							class="block text-sm text-[var(--muted-foreground)] transition-colors hover:text-[var(--foreground)]"
						>
							{item.text}
						</a>
						{item.children.length > 0 && (
							<Astro.self items={item.children} level={level + 1} />
						)}
					</li>
				))}
			</ol>
		) : (
			<ul class="mt-3 space-y-3 border-l border-[var(--border)] pl-3">
				{items.map((item) => (
					<li>
						<a
							href={`#${item.slug}`}
							class="block text-sm text-[var(--muted-foreground)] transition-colors hover:text-[var(--foreground)]"
						>
							{item.text}
						</a>
						{item.children.length > 0 && (
							<Astro.self items={item.children} level={level + 1} />
						)}
					</li>
				))}
			</ul>
		)
	)
}
