---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;
---

<div class="mb-6 grid border-t border-l border-[var(--border)] bg-transparent md:grid-cols-2">
    {page.data.map((entry: CollectionEntry<"posts">) => (
        <article class="border-b border-r border-[var(--border)]">
            <PostCard
                    entry={entry}
                    title={entry.data.title}
                    published={entry.data.published}
                    updated={entry.data.updated}
                    url={getPostUrlBySlug(entry.id)}
                    image={entry.data.image}
                    description={entry.data.description}
                    draft={entry.data.draft}
                    loading="eager"
            ></PostCard>
        </article>
    ))}
</div>
