---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;
---

<div
	id="post-list-container"
	class="mb-6 grid overflow-hidden border border-white/10 bg-transparent md:grid-cols-2"
>

    {page.data.map((entry: CollectionEntry<"posts">) => (
        <article class="border-b border-white/10 md:odd:border-r">
            <PostCard
                    entry={entry}
                    title={entry.data.title}
                    published={entry.data.published}
                    updated={entry.data.updated}
                    url={getPostUrlBySlug(entry.id)}
                    image={entry.data.image}
                    description={entry.data.description}
                    draft={entry.data.draft}
                    loading="lazy"
            ></PostCard>
        </article>
    ))}
</div>
