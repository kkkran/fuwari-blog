---
import path from "node:path";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Icon from "@components/Icon.astro";

import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	image?: string;
	description: string;
	draft?: boolean;
	style?: string;
	loading?: "eager" | "lazy";
}

const {
	entry,
	title,
	url,
	published,
	image,
	description,
	style,
	loading = "lazy",
} = Astro.props;

const isPinned = entry.data.pinned === true;
const className = Astro.props.class;
const hasCover = image !== undefined && image !== null && image !== "";
const tags = entry.data.tags?.slice(0, 1) ?? [];
const { remarkPluginFrontmatter } = await render(entry);
const summary = description || remarkPluginFrontmatter.excerpt;
---

<a
	href={url}
	aria-label={title}
	class:list={[
		"group flex w-full items-center gap-3 p-3 transition-colors duration-75 hover:bg-[var(--card)] sm:gap-4 sm:p-5",
		className,
	]}
	style={style}
>
	<div class="cover-skeleton-wrapper relative h-16 w-24 shrink-0 overflow-hidden bg-[var(--card)] sm:h-24 sm:w-36">
		{hasCover ? (
			<div class="cover-skeleton absolute inset-0" aria-hidden="true"></div>
			<ImageWrapper
				src={image}
				basePath={path.join("content/posts/", getDir(entry.id))}
				alt={`Cover Image of ${title}`}
				class="h-full w-full"
				loading={loading}
				objectFit="cover"
			/>
		) : (
			<div class="flex h-full w-full items-center justify-center border border-[var(--border)]">
				<img src="/favicon/shijies-nook.svg" alt="" class="h-9 w-9 opacity-55" width="36" height="36" />
			</div>
		)}
	</div>

	<div class="min-w-0 flex-1 space-y-2.5 py-1">
		<div class="mb-2 flex flex-wrap items-center gap-2 text-xs leading-none text-[var(--muted-foreground)]">
			{isPinned && (
				<span class="inline-flex items-center gap-1 text-xs font-medium text-amber-400">
					<Icon name="material-symbols:push-pin-rounded" class="mr-0.5 inline-block text-[0.9rem]" />
					置顶
				</span>
			)}
			<span>{formatDateToYYYYMMDD(published)}</span>
			<span>·</span>
			{tags.length > 0 ? <span>{tags[0]}</span> : <span>随笔</span>}
			<span>·</span>
			<span>{remarkPluginFrontmatter.minutes} 分钟</span>
		</div>
		<h2 class="line-clamp-2 text-base font-semibold leading-snug text-[var(--foreground)] transition-colors group-hover:text-[var(--primary)] sm:text-lg">
			{title}
		</h2>
		<p class="line-clamp-2 text-sm leading-6 text-[var(--muted-foreground)]">
			{summary}
		</p>
	</div>
</a>

<style>
	/* 封面图懒加载骨架占位：深底 + 浅灰斜线纹理，图片加载完成后隐藏 */
	.cover-skeleton {
		background-color: #262626;
		background-image: repeating-linear-gradient(
			45deg,
			transparent 0,
			transparent 10px,
			rgba(255, 255, 255, 0.07) 10px,
			rgba(255, 255, 255, 0.07) 20px
		);
	}
</style>

<script>
	// 封面图加载完成后隐藏骨架占位；加载失败也隐藏，避免占位残留
	function hideCoverSkeleton(img) {
		const skeleton = img.closest(".cover-skeleton-wrapper")?.querySelector(".cover-skeleton");
		if (skeleton) skeleton.classList.add("hidden");
	}

	function initCoverSkeletons() {
		document.querySelectorAll("img.image-content").forEach((img) => {
			if (img.closest(".cover-skeleton-wrapper") === null) return;
			if (img.complete) {
				hideCoverSkeleton(img);
				return;
			}
			img.addEventListener("load", () => hideCoverSkeleton(img), { once: true });
			img.addEventListener("error", () => hideCoverSkeleton(img), { once: true });
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initCoverSkeletons, { once: true });
	} else {
		initCoverSkeletons();
	}
</script>
