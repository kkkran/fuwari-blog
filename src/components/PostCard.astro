---
import path from "node:path";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Icon from "@components/Icon.astro";

import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getDir } from "../utils/url-utils";
import { estimateMinutes } from "../utils/blog-db";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	image?: string;
	description: string;
	draft?: boolean;
	style?: string;
	loading?: "eager" | "lazy";
}

const {
	entry,
	title,
	url,
	published,
	image,
	description,
	style,
	loading = "lazy",
} = Astro.props;

const isPinned = entry.data.pinned === true;
const className = Astro.props.class;
const hasCover = image !== undefined && image !== null && image !== "";
const tags = entry.data.tags?.slice(0, 1) ?? [];
// 数据库文章（混合数据源）不经过 content collection 的 render，直接使用描述与估算值
const isDb = (entry as CollectionEntry<"posts"> & { __source?: string }).__source === "db";
const remarkPluginFrontmatter = isDb
	? {
			excerpt:
				description ||
				(entry.body ? entry.body.slice(0, 120).replace(/\s+/g, " ").trim() : ""),
			minutes: estimateMinutes(entry.body || entry.data.title),
		}
	: (await render(entry)).remarkPluginFrontmatter;
const summary = description || remarkPluginFrontmatter.excerpt;
---

<a
	href={url}
	aria-label={title}
	class:list={[
		"group relative flex w-full items-center gap-3 p-3 transition-colors duration-75 hover:bg-[var(--card)] sm:gap-4 sm:p-5",
		className,
	]}
	style={style}
>
	{hasCover && (
		<div class="card-skeleton absolute inset-0 z-[-1] flex items-center gap-3 p-3 sm:gap-4 sm:p-5" aria-hidden="true">
			<div class="skeleton-stripe h-16 w-24 shrink-0 sm:h-24 sm:w-36"></div>
			<div class="min-w-0 flex-1 space-y-2.5 py-1">
				<div class="skeleton-stripe h-3 w-32 rounded-sm"></div>
				<div class="skeleton-stripe mt-2 h-4 w-3/4 rounded-sm"></div>
				<div class="skeleton-stripe h-3 w-full rounded-sm"></div>
			</div>
		</div>
	)}
	<div class="cover-skeleton-wrapper relative h-16 w-24 shrink-0 overflow-hidden bg-[var(--card)] sm:h-24 sm:w-36">
		{hasCover ? (
			<Fragment>
				{isDb ? (
					<img
						src={image}
						alt={`Cover Image of ${title}`}
						class="image-content h-full w-full object-cover"
						loading={loading}
					/>
				) : (
					<ImageWrapper
						src={image}
						basePath={path.join("content/posts/", getDir(entry.id))}
						alt={`Cover Image of ${title}`}
						class="h-full w-full"
						loading={loading}
						objectFit="cover"
					/>
				)}
			</Fragment>
		) : (
			<div class="flex h-full w-full items-center justify-center border border-[var(--border)]">
				<img src="/seo-cover-64.webp" alt="" class="h-9 w-9 opacity-55" width="36" height="36" />
			</div>
		)}
	</div>

	<div class="min-w-0 flex-1 space-y-2.5 py-1">
		<div class="mb-2 flex flex-wrap items-center gap-2 text-xs leading-none text-[var(--muted-foreground)]">
			{isPinned && (
				<span class="inline-flex items-center gap-1 text-xs font-medium text-amber-400">
					<Icon name="material-symbols:push-pin-rounded" class="mr-0.5 inline-block text-[0.9rem]" />
					置顶
				</span>
			)}
			<span>{formatDateToYYYYMMDD(published)}</span>
			<span>·</span>
			{tags.length > 0 ? <span>{tags[0]}</span> : <span>随笔</span>}
			<span>·</span>
			<span>{remarkPluginFrontmatter.minutes} 分钟</span>
		</div>
		<h2 class="line-clamp-2 text-base font-semibold leading-snug text-[var(--foreground)] transition-colors group-hover:text-[var(--primary)] sm:text-lg">
			{title}
		</h2>
		<p class="line-clamp-2 text-sm leading-6 text-[var(--muted-foreground)]">
			{summary}
		</p>
	</div>
</a>

<style>
	/* 整卡骨架作为卡片背景层（z-index:-1）：内容层天然在其上方，
	   封面图加载完成后自然盖住骨架区域，无需 JS 隐藏，结构上不会与内容重叠 */
	.skeleton-stripe {
		background-color: #262626;
		background-image:
			repeating-linear-gradient(
				45deg,
				transparent 0,
				transparent 10px,
				rgba(255, 255, 255, 0.07) 10px,
				rgba(255, 255, 255, 0.07) 20px
			),
			linear-gradient(
				100deg,
				rgba(255, 255, 255, 0.05) 40%,
				rgba(255, 255, 255, 0.14) 50%,
				rgba(255, 255, 255, 0.05) 60%
			);
		background-size:
			auto,
			200% 100%;
		animation: skeleton-shimmer 1.4s infinite;
	}
	@keyframes skeleton-shimmer {
		0% {
			background-position:
				0 0,
				120% 0;
		}
		100% {
			background-position:
				0 0,
				-80% 0;
		}
	}
	.card-skeleton {
		pointer-events: none;
	}
</style>
