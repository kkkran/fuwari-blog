---
import path from "node:path";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Icon from "@components/Icon.astro";

import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	image?: string;
	description: string;
	draft?: boolean;
	style?: string;
	loading?: "eager" | "lazy";
}

const {
	entry,
	title,
	url,
	published,
	image,
	description,
	style,
	loading = "lazy",
} = Astro.props;

const isPinned = entry.data.pinned === true;
const className = Astro.props.class;
const hasCover = image !== undefined && image !== null && image !== "";
const tags = entry.data.tags?.slice(0, 1) ?? [];
const { remarkPluginFrontmatter } = await render(entry);
const summary = description || remarkPluginFrontmatter.excerpt;
---

<a
	href={url}
	aria-label={title}
	class:list={[
		"group flex min-h-[8.25rem] w-full gap-4 p-5 transition-colors hover:bg-white/[0.04]",
		className,
	]}
	style={style}
>
	<div class="h-24 w-36 shrink-0 overflow-hidden bg-white/[0.03] sm:w-40">
		{hasCover ? (
			<ImageWrapper
				src={image}
				basePath={path.join("content/posts/", getDir(entry.id))}
				alt={`Cover Image of ${title}`}
				class="h-full w-full"
				loading={loading}
				objectFit="cover"
			/>
		) : (
			<div class="flex h-full w-full items-center justify-center border border-white/10">
				<img src="/favicon/shijies-nook.svg" alt="" class="h-9 w-9 opacity-55" width="36" height="36" />
			</div>
		)}
	</div>

	<div class="flex min-w-0 flex-1 flex-col justify-center">
		<div class="mb-2 flex flex-wrap items-center gap-2 text-xs text-white/48">
			{isPinned && (
				<span class="font-medium text-amber-300">
					<Icon name="material-symbols:push-pin-rounded" class="mr-0.5 inline-block text-[0.9rem]" />
					置顶
				</span>
			)}
			<span>{formatDateToYYYYMMDD(published)}</span>
			<span>·</span>
			{tags.length > 0 ? <span>{tags[0]}</span> : <span>随笔</span>}
			<span>·</span>
			<span>{remarkPluginFrontmatter.minutes} 分钟</span>
		</div>
		<h2 class="line-clamp-2 text-[1.05rem] font-bold leading-snug text-white/92 transition-colors group-hover:text-white">
			{title}
		</h2>
		<p class="mt-2 line-clamp-2 text-sm leading-6 text-white/58">
			{summary}
		</p>
	</div>
</a>
