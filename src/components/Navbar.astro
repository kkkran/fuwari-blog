---
import Icon from "@components/Icon.astro";
import AuthNav from "@components/blog/AuthNav.svelte";
import { navBarConfig, profileConfig, siteConfig } from "../config";
import type { NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";

const className = Astro.props.class;
const links = navBarConfig.links as NavBarLink[];
const primaryLinks = links.filter(
	(link) => link.name !== "工具" && link.name !== "AI 生图",
);
const toolsLink = links.find((link) => link.name === "工具");
// AI 生图导航：下拉展示画廊 / 图片生成 / 互动小说
const aiLink = links.find((link) => link.name === "AI 生图");
const aiSubLinks: NavBarLink[] = [
	{
		name: "AI 生图（画廊）",
		url: "/tools/gallery/",
		icon: "material-symbols:palette-outline-rounded",
	},
	{
		name: "AI 图片生成",
		url: "/tools/ai-image/",
		icon: "material-symbols:auto-awesome-outline-rounded",
	},
	{
		name: "AI 小说互动",
		url: "/tools/ai-story/",
		icon: "material-symbols:auto-stories-outline-rounded",
	},
];
const toolLinks: NavBarLink[] = [
	{
		name: "画廊",
		url: "/tools/gallery/",
		icon: "material-symbols:photo-library-outline-rounded",
	},
	{
		name: "文件",
		url: "/tools/files/",
		icon: "material-symbols:folder-open-outline-rounded",
	},
	{
		name: "封面",
		url: "/tools/cover/",
		icon: "material-symbols:image-outline-rounded",
	},
	{
		name: "长链接",
		url: "/tools/long-link/",
		icon: "material-symbols:link-rounded",
	},
	{
		name: "全部工具",
		url: "/tools/",
		icon: "material-symbols:grid-view-outline-rounded",
	},
];
// 默认品牌头像使用 64px 变体（241KB 原图用于 28px 展示属浪费）
const avatarSrc =
	(profileConfig.avatar || "/seo-cover.webp") === "/seo-cover.webp"
		? "/seo-cover-64.webp"
		: profileConfig.avatar;
---

<header
	id="navbar"
	class:list={[
		className,
		"relative z-50 w-full border-b border-[var(--border)]/40 bg-[var(--background)]",
	]}
>
	<div class="mx-auto flex h-14 max-w-[var(--site-shell-width)] items-center justify-between gap-4 px-3 sm:px-4">
		<a
			href={url("/")}
			aria-label={siteConfig.title}
			class="flex min-w-0 items-center gap-2 font-semibold tracking-tight"
		>
			<img
				src={avatarSrc}
				alt=""
				width="28"
				height="28"
				class="h-7 w-7 rounded-full object-cover"
			/>
			<span class="truncate text-sm text-[var(--foreground)]">{siteConfig.title}</span>
		</a>

		<nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
			{primaryLinks.map((link) => (
				<a
					href={link.external ? link.url : url(link.url)}
					target={link.external ? "_blank" : null}
					rel={link.external ? "noopener noreferrer" : null}
					class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm text-[var(--muted-foreground)] transition-colors hover:bg-[var(--foreground)] hover:text-[var(--background)]"
				>
					{link.icon && (
						<Icon name={link.icon} class="size-4 text-[var(--muted-foreground)]" />
					)}
					<span>{link.name}</span>
				</a>
			))}

			{aiLink && (
				<details class="group relative">
					<summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-md px-3 py-1.5 text-sm text-[var(--muted-foreground)] transition-colors hover:bg-[var(--foreground)] hover:text-[var(--background)]">
						{aiLink.icon && (
							<Icon name={aiLink.icon} class="size-4 text-[var(--muted-foreground)]" />
						)}
						<span>{aiLink.name}</span>
						<Icon
							name="material-symbols:keyboard-arrow-down-rounded"
							class="size-4 text-[var(--muted-foreground)] transition group-open:rotate-180"
						/>
					</summary>
					<div class="absolute left-0 top-full z-50 mt-2 w-max min-w-36 border border-[var(--foreground)]/80 bg-[var(--popover)] p-1 font-mono text-[var(--popover-foreground)]">
						{aiSubLinks.map((link) => (
							<a
								href={url(link.url)}
								class="flex items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none transition-colors hover:bg-[var(--foreground)] hover:text-[var(--background)] focus:bg-[var(--foreground)] focus:text-[var(--background)]"
							>
								{link.icon && (
									<Icon name={link.icon} class="size-4 text-[var(--muted-foreground)]" />
								)}
								<span>{link.name}</span>
							</a>
						))}
					</div>
				</details>
			)}

			{toolsLink && (
				<details class="group relative">
					<summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-md px-3 py-1.5 text-sm text-[var(--muted-foreground)] transition-colors hover:bg-[var(--foreground)] hover:text-[var(--background)]">
						{toolsLink.icon && (
							<Icon name={toolsLink.icon} class="size-4 text-[var(--muted-foreground)]" />
						)}
						<span>{toolsLink.name}</span>
						<Icon
							name="material-symbols:keyboard-arrow-down-rounded"
							class="size-4 text-[var(--muted-foreground)] transition group-open:rotate-180"
						/>
					</summary>
					<div class="absolute left-0 top-full z-50 mt-2 w-max min-w-32 border border-[var(--foreground)]/80 bg-[var(--popover)] p-1 font-mono text-[var(--popover-foreground)]">
						{toolLinks.map((link) => (
							<a
								href={url(link.url)}
								class="flex items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none transition-colors hover:bg-[var(--foreground)] hover:text-[var(--background)] focus:bg-[var(--foreground)] focus:text-[var(--background)]"
							>
								{link.icon && (
									<Icon name={link.icon} class="size-4 text-[var(--muted-foreground)]" />
								)}
								<span>{link.name}</span>
							</a>
						))}
					</div>
				</details>
			)}
		</nav>

		<AuthNav client:load />

		<details class="relative shrink-0 md:hidden">
			<summary
				aria-label="打开菜单"
				class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md text-[var(--muted-foreground)] transition-colors hover:bg-[var(--foreground)] hover:text-[var(--background)]"
			>
				<Icon name="material-symbols:menu-rounded" class="text-[1.35rem]"></Icon>
			</summary>
			<div class="absolute right-0 top-full flex h-[calc(100dvh-3.5rem)] w-72 flex-col overflow-y-auto border-l border-[var(--border)] bg-[var(--background)] p-4">
				<div class="flex items-center gap-2.5 text-sm font-semibold">
					<img
						src={avatarSrc}
						alt=""
						width="24"
						height="24"
						class="h-6 w-6 rounded-full object-cover"
					/>
					<span>{siteConfig.title}</span>
				</div>
				<div class="mt-6 flex flex-1 flex-col gap-1">
					{primaryLinks.map((link) => (
						<a
							href={link.external ? link.url : url(link.url)}
							target={link.external ? "_blank" : null}
							rel={link.external ? "noopener noreferrer" : null}
							class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm transition-colors hover:bg-[var(--foreground)] hover:text-[var(--background)]"
						>
							{link.icon && (
								<Icon name={link.icon} class="size-4 shrink-0 text-[var(--muted-foreground)]" />
							)}
							<span>{link.name}</span>
						</a>
					))}
					{aiSubLinks.length > 0 && (
						<>
							<div class="mb-1 mt-3 px-3">
								<p class="text-xs font-medium uppercase tracking-wider text-[var(--muted-foreground)]/80">
									AI
								</p>
							</div>
							{aiSubLinks.map((link) => (
								<a
									href={url(link.url)}
									class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm transition-colors hover:bg-[var(--foreground)] hover:text-[var(--background)]"
								>
									<Icon name={link.icon} class="size-4 shrink-0 text-[var(--muted-foreground)]" />
									<span>{link.name}</span>
								</a>
							))}
						</>
					)}
					{toolLinks.length > 0 && (
						<>
							<div class="mb-1 mt-3 px-3">
								<p class="text-xs font-medium uppercase tracking-wider text-[var(--muted-foreground)]/80">
									工具
								</p>
							</div>
							{toolLinks.map((link) => (
								<a
									href={url(link.url)}
									class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm transition-colors hover:bg-[var(--foreground)] hover:text-[var(--background)]"
								>
									<Icon name={link.icon} class="size-4 shrink-0 text-[var(--muted-foreground)]" />
									<span>{link.name}</span>
								</a>
							))}
						</>
					)}
				</div>
			</div>
		</details>
	</div>

	<!-- 页面滚动进度条：贴在导航栏底部，随页面滚动更新宽度 -->
	<div
		id="scroll-progress"
		class="absolute bottom-0 left-0 h-[3px] w-full origin-left scale-x-0 bg-[var(--primary)] will-change-transform"
		aria-hidden="true"
	></div>
</header>

<script>
	// 页面滚动进度：scaleX(0~1) 表示当前阅读/滚动进度
	function updateScrollProgress() {
		const bar = document.getElementById("scroll-progress");
		if (!bar) return;
		const doc = document.documentElement;
		const scrollTop = doc.scrollTop || document.body.scrollTop;
		const scrollHeight = doc.scrollHeight - doc.clientHeight;
		const progress =
			scrollHeight > 0 ? Math.min(1, scrollTop / scrollHeight) : 0;
		bar.style.transform = `scaleX(${progress})`;
	}

	window.addEventListener("scroll", updateScrollProgress, { passive: true });

	// 点击下拉菜单（AI 生图/工具/移动端菜单）外部时自动关闭
	document.addEventListener("click", function (e) {
		document.querySelectorAll("header details[open]").forEach(function (details) {
			if (!details.contains(e.target as Node)) {
				details.removeAttribute("open");
			}
		});
	});
	window.addEventListener("resize", updateScrollProgress);

	function initScrollProgress() {
		updateScrollProgress();
	}
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initScrollProgress, {
			once: true,
		});
	} else {
		initScrollProgress();
	}
</script>
