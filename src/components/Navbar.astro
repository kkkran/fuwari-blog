---
import Icon from "@components/Icon.astro";
import { navBarConfig, profileConfig, siteConfig } from "../config";
import type { NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";

const className = Astro.props.class;
const links = navBarConfig.links as NavBarLink[];
const primaryLinks = links.filter((link) => link.name !== "工具");
const toolsLink = links.find((link) => link.name === "工具");
const toolLinks: NavBarLink[] = [
	{
		name: "画廊",
		url: "/tools/gallery/",
		icon: "material-symbols:photo-library-outline-rounded",
	},
	{
		name: "文件",
		url: "/tools/files/",
		icon: "material-symbols:folder-open-outline-rounded",
	},
	{
		name: "封面",
		url: "/tools/cover/",
		icon: "material-symbols:image-outline-rounded",
	},
	{
		name: "长链接",
		url: "/tools/long-link/",
		icon: "material-symbols:link-rounded",
	},
	{
		name: "全部工具",
		url: "/tools/",
		icon: "material-symbols:grid-view-outline-rounded",
	},
];
---

<header
	id="navbar"
	class:list={[
		className,
		"nav-shell z-50 w-full border-b border-white/10 bg-[var(--page-bg)]/95",
	]}
>
	<div class="mx-auto flex h-11 max-w-[var(--site-shell-width)] items-center justify-between px-3 sm:px-4">
		<a
			href={url("/")}
			aria-label={siteConfig.title}
			class="group flex min-w-0 items-center gap-2 font-semibold tracking-tight"
		>
			<span class="flex h-7 w-7 shrink-0 items-center justify-center overflow-hidden rounded-sm border border-white/10 bg-white/[0.04]">
				<img
					src={profileConfig.avatar || "/favicon/shijies-nook.svg"}
					alt=""
					class="h-full w-full object-cover p-0.5"
					width="28"
					height="28"
				/>
			</span>
			<span class="truncate text-sm font-bold text-white/90">{siteConfig.title}</span>
		</a>

		<nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
			{primaryLinks.map((link) => (
				<a
					href={link.external ? link.url : url(link.url)}
					target={link.external ? "_blank" : null}
					rel={link.external ? "noopener noreferrer" : null}
					class="group flex h-9 items-center gap-1.5 rounded-md px-2.5 text-sm text-white/62 transition-colors hover:bg-white/[0.07] hover:text-white"
				>
					{link.icon && (
						<Icon
							name={link.icon}
							class="text-[1rem] text-white/45 transition-colors group-hover:text-white/75"
						/>
					)}
					<span>{link.name}</span>
				</a>
			))}

			{toolsLink && (
				<details class="group relative">
					<summary class="flex h-9 cursor-pointer list-none items-center gap-1.5 rounded-md px-2.5 text-sm text-white/62 transition-colors hover:bg-white/[0.07] hover:text-white">
						{toolsLink.icon && (
							<Icon
								name={toolsLink.icon}
								class="text-[1rem] text-white/45 transition-colors group-hover:text-white/75"
							/>
						)}
						<span>{toolsLink.name}</span>
						<Icon
							name="material-symbols:keyboard-arrow-down-rounded"
							class="text-[1rem] text-white/38 transition group-open:rotate-180"
						/>
					</summary>
					<div class="absolute right-0 top-full mt-1 w-56 rounded-lg border border-white/10 bg-[var(--float-panel-bg-opaque)] p-2 shadow-xl">
						{toolLinks.map((link) => (
							<a
								href={url(link.url)}
								class="group/tool flex items-center gap-2 rounded-md px-3 py-2 text-sm text-white/68 transition hover:bg-white/[0.07] hover:text-white"
							>
								{link.icon && (
									<Icon
										name={link.icon}
										class="text-[1rem] text-white/42 transition group-hover/tool:text-white/75"
									/>
								)}
								<span>{link.name}</span>
							</a>
						))}
					</div>
				</details>
			)}
		</nav>

		<details class="relative shrink-0 md:hidden">
			<summary
				aria-label="打开菜单"
				class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md text-white/72 transition hover:bg-white/[0.07] hover:text-white"
			>
				<Icon name="material-symbols:menu-rounded" class="text-[1.35rem]"></Icon>
			</summary>
			<div class="fixed inset-x-0 top-11 border-b border-white/10 bg-[var(--page-bg)] p-3 shadow-xl">
				<nav class="mx-auto grid max-w-[var(--site-shell-width)] gap-1" aria-label="移动主导航">
					{primaryLinks.map((link) => (
						<a
							href={url(link.url)}
							class="flex items-center gap-2 rounded-md px-3 py-2.5 text-sm text-white/72 transition hover:bg-white/[0.07] hover:text-white"
						>
							{link.icon && <Icon name={link.icon} class="text-[1rem] text-white/45" />}
							<span>{link.name}</span>
						</a>
					))}
					<div class="mt-2 border-t border-white/10 pt-2">
						<a
							href={url("/tools/")}
							class="flex items-center gap-2 rounded-md px-3 py-2.5 text-sm text-white/72 transition hover:bg-white/[0.07] hover:text-white"
						>
							<Icon name="material-symbols:business-center-outline-rounded" class="text-[1rem] text-white/45" />
							<span>工具</span>
						</a>
					</div>
				</nav>
			</div>
		</details>
	</div>
</header>
