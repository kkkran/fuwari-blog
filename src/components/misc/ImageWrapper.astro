---
import path from "node:path";
interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "eager" | "lazy";
	objectFit?: "cover" | "contain";
}
import { serviceConfig, siteConfig } from "../../config";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	loading = "lazy",
	objectFit = "cover",
} = Astro.props;
const className = Astro.props.class;

// 判断图片类型
const isRandom = src === "random" || src.includes("random");
const isExternal = src.startsWith("http") || src.startsWith("https") || src.startsWith("data:");
const isPublic = src.startsWith("/");
const isLocal = !isExternal && !isPublic && !isRandom;

// 计算最终路径
let finalSrc = src;
if (isRandom) {
	finalSrc = `${serviceConfig.assetsBaseUrl}/ri/h/1.webp`;
} else if (isLocal) {
	// 本地相对路径：'/public/assets/images/xxx.webp'
	// 转换为绝对路径：'/public/assets/images/xxx.webp'
	// public 目录下的文件在构建后直接映射到根路径
	finalSrc = src.replace(/^\.\.\//, "/");
} else if (isPublic) {
	finalSrc = url(src);
}

const imageClass = `w-full h-full object-${objectFit}`;
const imageStyle = `object-position: ${position}`;
const fetchPriority = loading === "eager" ? "high" : "low";
---
<div id={id} class:list={[className, 'overflow-hidden relative image-wrapper']} style={`--theme-hue: ${siteConfig.themeColor.hue}`}>
	<!-- 加载占位骨架层：图片加载完成前显示 shimmer，加载后自然被图片盖住 -->
	<div class="image-wrapper-skeleton" aria-hidden="true"></div>
	<img 
		src={finalSrc} 
		alt={alt || ""} 
		class={`${imageClass} image-content ${isRandom ? 'post-cover-random' : ''}`} 
		style={imageStyle} 
		loading={loading} 
		fetchpriority={fetchPriority} 
		decoding="async"
	/>
</div>

<style>
    .image-content {
        transition: none;
        position: relative;
        z-index: 1;
    }
    .image-wrapper {
        min-height: 0;
    }
    .image-content[loading="lazy"] {
        content-visibility: auto;
    }
    .image-wrapper-skeleton {
        position: absolute;
        inset: 0;
        z-index: 0;
        background-color: #262626;
        background-image:
            repeating-linear-gradient(
                45deg,
                transparent 0,
                transparent 10px,
                rgba(255, 255, 255, 0.07) 10px,
                rgba(255, 255, 255, 0.07) 20px
            ),
            linear-gradient(
                100deg,
                rgba(255, 255, 255, 0.05) 40%,
                rgba(255, 255, 255, 0.14) 50%,
                rgba(255, 255, 255, 0.05) 60%
            );
        background-size:
            auto,
            200% 100%;
        animation: image-wrapper-skeleton-shimmer 1.4s infinite;
    }
    @keyframes image-wrapper-skeleton-shimmer {
        0% {
            background-position:
                0 0,
                120% 0;
        }
        100% {
            background-position:
                0 0,
                -80% 0;
        }
    }
</style>
