---
// 静态渐变背景组件 - 无动画，零性能开销
---

<div class="bg-container"></div>

<style is:global>
	.bg-container {
		display: flex;
		justify-content: center;
		align-items: center;
		min-height: 100vh;
		background:
			linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px),
			linear-gradient(0deg, rgb(255 255 255 / 0.028) 1px, transparent 1px),
			radial-gradient(ellipse at 80% 0%, rgb(142 197 164 / 0.12), transparent 42%),
			#101613;
		background-size:
			44px 44px,
			44px 44px,
			100% 100%,
			100% 100%;
		overflow: hidden;
		flex-direction: column;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: -2;
	}
</style>
