---
import Icon from "@components/Icon.astro";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;
---
<div class:list={["post-sort-container mb-3 flex flex-col gap-2 border-y border-white/10 px-1 py-2 text-neutral-400 sm:flex-row sm:items-center sm:justify-between", className]} style={style}>
    <div class="flex items-center gap-2 text-xs uppercase tracking-[0.16em] text-white/35">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--primary)]"></span>
        <span>Writing Stream</span>
    </div>
    <div class="flex w-full items-center justify-between gap-2 sm:w-auto sm:justify-start">
    <div class="flex bg-[var(--card-bg-transparent)] p-1 shadow-sm border border-white/10 rounded-lg">
        <button data-sort-type="date"
           class="sort-btn active" 
           title="按发布日期排序">
            <Icon name="material-symbols:schedule-outline-rounded" class="text-xl"></Icon>
        </button>
        <button data-sort-type="views"
           class="sort-btn" 
           title="按访问量排序">
            <Icon name="material-symbols:visibility-outline-rounded" class="text-xl"></Icon>
        </button>
    </div>
    <button data-sort-order
       class="btn-regular px-3 h-9 flex items-center gap-1 active:scale-95 transition border border-white/10" 
       title="切换正序/倒序">
        <Icon name="material-symbols:arrow-downward-rounded" 
              class="text-xl transition-transform"></Icon>
        <span class="text-sm font-medium">倒序</span>
    </button>
    </div>
</div>

<style>
    .sort-btn {
        @apply p-1.5 transition-all flex items-center justify-center hover:bg-white/5 active:scale-90 rounded-md;
    }
    .sort-btn.active {
        @apply bg-[var(--primary)] text-black/80 shadow-sm hover:bg-[var(--primary)];
    }
</style>
