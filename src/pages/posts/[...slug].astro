---
import path from "node:path";
import Icon from "@components/Icon.astro";
import Markdown from "@components/misc/Markdown.astro";
import TOC from "@components/widget/TOC.astro";
import SiteShellLayout from "@layouts/SiteShellLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { render } from "astro:content";
import PostMetadata from "../../components/PostMeta.astro";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import { profileConfig, serviceConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
import {
	fetchDbPost,
	fetchDbPostsAll,
	renderDbMarkdown,
	type DbPostFull,
} from "../../utils/blog-db";
import {
	computePrevNext,
	mergeSortedPosts,
} from "../../utils/post-sorting";

// 混合数据源详情：先查 md 文章（content collection），未命中再查数据库文章；均未命中 404
export const prerender = false;

const slug = Astro.params.slug ?? "";
const allPosts = await getSortedPosts();
const entry = allPosts.find((post) => post.id === slug) ?? null;

// 合并 md + db 计算上一篇/下一篇（跨数据源）
const dbAllPosts = await fetchDbPostsAll();
const mergedPosts = mergeSortedPosts({ mdPosts: allPosts, dbPosts: dbAllPosts });
const { prev, next } = computePrevNext(mergedPosts, slug);

let dbPost: DbPostFull | null = null;
let dbContentHtml = "";
// eslint-disable-next-line @typescript-eslint/no-explicit-any
let Content: any = null;
let mdHeadings: unknown[] = [];
// eslint-disable-next-line @typescript-eslint/no-explicit-any
let mdRemark: Record<string, any> = {};

if (!entry) {
	dbPost = await fetchDbPost(slug);
	if (dbPost) {
		dbContentHtml = await renderDbMarkdown(dbPost.content);
	}
} else {
	const rendered = await render(entry);
	Content = rendered.Content;
	mdHeadings = rendered.headings;
	mdRemark = rendered.remarkPluginFrontmatter;
}

if (!entry && !dbPost) {
	return Astro.rewrite("/404");
}

const jsonLdMd = entry
	? [
			{
				"@context": "https://schema.org",
				"@type": "BlogPosting",
				headline: entry.data.title,
				description: entry.data.description || entry.data.title,
				author: {
					"@type": "Person",
					name: profileConfig.name,
					url: Astro.site,
				},
				datePublished: formatDateToYYYYMMDD(entry.data.published),
				dateModified: entry.data.updated
					? formatDateToYYYYMMDD(entry.data.updated)
					: formatDateToYYYYMMDD(entry.data.published),
				mainEntityOfPage: {
					"@type": "WebPage",
					"@id": Astro.url,
				},
				inLanguage: entry.data.lang
					? entry.data.lang.replace("_", "-")
					: siteConfig.lang.replace("_", "-"),
				image: entry.data.image,
			},
			{
				"@context": "https://schema.org",
				"@type": "BreadcrumbList",
				itemListElement: [
					{
						"@type": "ListItem",
						position: 1,
						name: "首页",
						item: Astro.site,
					},
					{
						"@type": "ListItem",
						position: 2,
						name: "归档",
						item: new URL("/archive", Astro.site).toString(),
					},
					{
						"@type": "ListItem",
						position: 3,
						name: entry.data.title,
						item: Astro.url,
					},
				],
			},
		]
	: [];

const jsonLdDb = dbPost
	? {
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: dbPost.title,
			description: dbPost.description || dbPost.title,
			author: { "@type": "Person", name: dbPost.authorName },
			datePublished: dbPost.publishedAt
				? formatDateToYYYYMMDD(new Date(dbPost.publishedAt))
				: "",
			dateModified: dbPost.updatedAt
				? formatDateToYYYYMMDD(new Date(dbPost.updatedAt))
				: "",
			mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url },
			inLanguage: siteConfig.lang.replace("_", "-"),
			image: dbPost.image || undefined,
		}
	: null;

const tags = entry ? (entry.data.tags ?? []) : (dbPost?.tags ?? []);
const hasNext = !!next;
const hasPrev = !!prev;
const pageTitle = entry ? entry.data.title : (dbPost?.title ?? "");
const pageDescription = entry
	? entry.data.description
	: (dbPost?.description ?? "");
---

<SiteShellLayout
	title={pageTitle}
	description={pageDescription}
	lang={entry?.data.lang}
	setOGTypeArticle={true}
	ogImage={entry?.data.image ?? dbPost?.image}
>
	{entry && (
		<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLdMd)}></script>
	)}
	{dbPost && (
		<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLdDb)}></script>
	)}

	<div class="grid grid-cols-1 gap-8 py-8 xl:grid-cols-[minmax(0,1fr)_320px]">
		<article class="min-w-0 max-w-3xl">
			<!-- 返回列表 -->
			<a
				href="/blog/"
				class="mb-4 inline-flex items-center gap-1 border border-[var(--border)] bg-[var(--card)] px-4 py-2.5 text-sm text-[var(--muted-foreground)] transition-colors hover:bg-[var(--accent)] hover:text-[var(--foreground)]"
			>
				<Icon name="material-symbols:arrow-back-rounded" class="size-4" />
				返回列表
			</a>

			{entry && (
				<Fragment>
					<!-- ============ md 文章（原链路） ============ -->
					<!-- 标题 -->
					<h1
						id="post-title"
						data-pagefind-body
						data-pagefind-weight="10"
						data-pagefind-meta="title"
						class="text-3xl font-bold tracking-tight"
					>
						{entry.data.title}
					</h1>

					<!-- 描述 -->
					{(entry.data.description || mdRemark.excerpt) && (
						<p class="mt-4 text-base leading-relaxed text-[var(--muted-foreground)]">
							{entry.data.description || mdRemark.excerpt}
						</p>
					)}

					<!-- meta -->
					<div class="mb-6 mt-3">
						<PostMetadata
							published={entry.data.published}
							updated={entry.data.updated}
						></PostMetadata>
						<span class="ml-2 font-mono text-xs text-[var(--muted-foreground)]">
							· {mdRemark.minutes} 分钟
						</span>
					</div>

					<!-- 封面 -->
					{entry.data.image && (
						<ImageWrapper
							id="post-cover"
							src={entry.data.image}
							basePath={path.join("content/posts/", getDir(entry.id))}
							class="mt-6 w-full cursor-zoom-in object-cover aspect-video"
						/>
					)}

					<!-- 正文 -->
					<div class="mt-8">
						<Markdown class="markdown-content">
							{Content && <Content />}
						</Markdown>
					</div>

					<!-- 标签 -->
					{tags.length > 0 && (
						<div class="mt-8 flex flex-wrap gap-2">
							{tags.map((tag) => (
								<span
									class="rounded-full bg-[var(--muted)] px-2.5 py-0.5 text-xs font-medium text-[var(--muted-foreground)]"
								>
									{tag}
								</span>
							))}
						</div>
					)}

					<!-- 上一篇 / 下一篇 -->
					<div class="mt-8 grid grid-cols-1 gap-3 border-t border-[var(--border)] pt-6 sm:grid-cols-2">
						{hasPrev ? (
							<a
								href={getPostUrlBySlug(prev!.slug)}
								class="rounded-lg border border-[var(--border)] bg-[var(--card)] p-4 transition-colors hover:bg-[var(--accent)]"
							>
								<div class="text-xs text-[var(--muted-foreground)]">上一篇</div>
								<div class="mt-1 line-clamp-2 text-sm font-semibold">{prev!.title}</div>
							</a>
						) : (
							<div class="rounded-lg border border-[var(--border)] bg-[var(--card)] p-4 opacity-50"></div>
						)}
						{hasNext ? (
							<a
								href={getPostUrlBySlug(next!.slug)}
								class="rounded-lg border border-[var(--border)] bg-[var(--card)] p-4 text-right transition-colors hover:bg-[var(--accent)]"
							>
								<div class="text-xs text-[var(--muted-foreground)]">下一篇</div>
								<div class="mt-1 line-clamp-2 text-sm font-semibold">{next!.title}</div>
							</a>
						) : (
							<div class="rounded-lg border border-[var(--border)] bg-[var(--card)] p-4 opacity-50"></div>
						)}
					</div>
				</Fragment>
			)}

			{!entry && dbPost && (
				<Fragment>
					<!-- ============ 数据库文章（社区发布） ============ -->
					<h1
						id="post-title"
						data-pagefind-body
						data-pagefind-weight="10"
						data-pagefind-meta="title"
						class="text-3xl font-bold tracking-tight"
					>
						{dbPost.title}
					</h1>

					{dbPost.description && (
						<p class="mt-4 text-base leading-relaxed text-[var(--muted-foreground)]">
							{dbPost.description}
						</p>
					)}

					<div class="mb-6 mt-3 flex items-center gap-2 text-sm">
						<span class="text-[var(--muted-foreground)]">
							作者：<span class="font-semibold text-[var(--foreground)]">{dbPost.authorName}</span>
						</span>
						<span class="text-[var(--muted-foreground)]">·</span>
						<PostMetadata
							published={new Date(dbPost.publishedAt ?? dbPost.updatedAt)}
							updated={new Date(dbPost.updatedAt)}
						></PostMetadata>
						<span class="text-[var(--muted-foreground)]">·</span>
						<span class="rounded-full bg-[var(--primary)]/15 px-2 py-0.5 text-xs font-semibold text-[var(--primary)]">
							社区文章
						</span>
					</div>

					{dbPost.image && (
						<img
							src={dbPost.image}
							alt={`Cover Image of ${dbPost.title}`}
							class="mt-6 aspect-video w-full cursor-zoom-in rounded-lg object-cover"
						/>
					)}

					<div class="mt-8">
						<div class="markdown-content" set:html={dbContentHtml} />
					</div>

					{tags.length > 0 && (
						<div class="mt-8 flex flex-wrap gap-2">
							{tags.map((tag) => (
								<span
									class="rounded-full bg-[var(--muted)] px-2.5 py-0.5 text-xs font-medium text-[var(--muted-foreground)]"
								>
									{tag}
								</span>
							))}
						</div>
					)}

					<!-- 上一篇 / 下一篇（社区文章同样纳入） -->
					<div class="mt-8 grid grid-cols-1 gap-3 border-t border-[var(--border)] pt-6 sm:grid-cols-2">
						{hasPrev ? (
							<a
								href={getPostUrlBySlug(prev!.slug)}
								class="rounded-lg border border-[var(--border)] bg-[var(--card)] p-4 transition-colors hover:bg-[var(--accent)]"
							>
								<div class="text-xs text-[var(--muted-foreground)]">上一篇</div>
								<div class="mt-1 line-clamp-2 text-sm font-semibold">{prev!.title}</div>
							</a>
						) : (
							<div class="rounded-lg border border-[var(--border)] bg-[var(--card)] p-4 opacity-50"></div>
						)}
						{hasNext ? (
							<a
								href={getPostUrlBySlug(next!.slug)}
								class="rounded-lg border border-[var(--border)] bg-[var(--card)] p-4 text-right transition-colors hover:bg-[var(--accent)]"
							>
								<div class="text-xs text-[var(--muted-foreground)]">下一篇</div>
								<div class="mt-1 line-clamp-2 text-sm font-semibold">{next!.title}</div>
							</a>
						) : (
							<div class="rounded-lg border border-[var(--border)] bg-[var(--card)] p-4 opacity-50"></div>
						)}
					</div>
				</Fragment>
			)}

			<!-- Giscus 评论区 -->
			<div id="giscus-container" class="giscus mt-10"></div>
			<script is:inline>
				function loadGiscus() {
					const container = document.getElementById('giscus-container');
					if (!container) return;

					// 清除旧的 Giscus
					container.innerHTML = '';

					// 创建新的 script 标签
					const script = document.createElement('script');
					script.src = 'https://giscus.app/client.js';
					script.setAttribute('data-repo', 'kkkran/fuwari-blog');
					script.setAttribute('data-repo-id', 'R_kgDOTzqaAw');
					script.setAttribute('data-category', 'Announcements');
					script.setAttribute('data-category-id', 'PENDING_CATEGORY_ID'); // TODO: 从 giscus.app 生成后替换
					script.setAttribute('data-mapping', 'pathname');
					script.setAttribute('data-strict', '1');
					script.setAttribute('data-reactions-enabled', '1');
					script.setAttribute('data-emit-metadata', '0');
					script.setAttribute('data-input-position', 'top');
					script.setAttribute('data-theme', 'dark');
					script.setAttribute('data-lang', 'zh-CN');
					script.setAttribute('data-loading', 'lazy');
					script.setAttribute('crossorigin', 'anonymous');
					script.async = true;

					container.appendChild(script);
				}

				// 页面加载时加载 Giscus
				loadGiscus();
			</script>
		</article>

		<!-- 右侧 TOC（仅 md 文章） -->
		{entry && siteConfig.toc.enable && (
			<aside class="hidden xl:block">
				<div class="sticky top-20">
					<div id="toc-inner-wrapper" class="max-h-[calc(100vh-6rem)] overflow-y-auto">
						<TOC headings={mdHeadings} />
					</div>
				</div>
			</aside>
		)}
	</div>
</SiteShellLayout>

<script define:vars={{ assetsBaseUrl: serviceConfig.assetsBaseUrl }}>
	// 随机封面图替换
	function setupRandomCovers() {
		const covers = document.querySelectorAll('.post-cover-random');
		if (!covers.length) return;
		const max = 1176;
		for (const img of covers) {
			const n = Math.floor(Math.random() * max) + 1;
			img.src = `${assetsBaseUrl}/ri/h/${n}.webp`;
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupRandomCovers);
	} else {
		setupRandomCovers();
	}
</script>

<style is:global>
	/* 确保包裹容器继承原图的圆角等样式 */
	.markdown-content img {
		margin-top: 0.5rem !important;
		margin-bottom: 0.5rem !important;
	}
</style>
