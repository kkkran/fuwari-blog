---
import Icon from "@components/Icon.astro";
import SiteShellLayout from "@layouts/SiteShellLayout.astro";
import { serviceConfig, siteConfig } from "../config";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug, url } from "../utils/url-utils";

const posts = (await getSortedPosts()).slice(0, 3);
const entryLinks = [
	{
		title: "阅读博客",
		description: "技术笔记、AI 工作流、工具实验和长期写作。",
		href: "/blog/",
		icon: "material-symbols:article-outline-rounded",
	},
	{
		title: "AI 生图",
		description: "浏览图像收藏和创作相关工具。",
		href: "/tools/gallery/",
		icon: "material-symbols:palette-outline-rounded",
	},
	{
		title: "实用工具",
		description: "封面生成、文件、短链与日常小工具。",
		href: "/tools/",
		icon: "material-symbols:business-center-outline-rounded",
	},
	{
		title: "朋友们",
		description: "站点友链与我常访问的角落。",
		href: "/friends/",
		icon: "material-symbols:link-rounded",
	},
];

const externalLinks = [
	{
		title: "GitHub",
		href: "https://github.com/miscoke",
		description: "代码、实验和公开项目。",
		icon: "simple-icons:github",
	},
	{
		title: "RSS",
		href: "/rss.xml",
		description: "订阅世界树栈的更新。",
		icon: "material-symbols:rss-feed-rounded",
	},
	{
		title: "站点状态",
		href: `${serviceConfig.umamiBaseUrl}/share/CdkXbGgZr6ECKOyK`,
		description: "查看站点访问统计。",
		icon: "material-symbols:monitor-heart-outline-rounded",
	},
];
---

<SiteShellLayout title="首页" description={siteConfig.description}>
	<section class="border-b border-white/10 py-16 sm:py-24">
		<p class="text-sm font-medium text-white/55">{siteConfig.subtitle}</p>
		<div class="mt-4 flex flex-col gap-7 lg:flex-row lg:items-end lg:justify-between">
			<div>
				<h1 class="max-w-3xl text-4xl font-semibold leading-tight text-white sm:text-6xl">
					世界树栈
					<br class="hidden sm:block" />
					把写作、实验和工具收进一个安静角落。
				</h1>
				<p class="mt-6 max-w-2xl text-base leading-7 text-white/62">
					这里是 Shijie’s Nook。记录技术实践、AI 工作流、数字生活与持续维护的小工具，也保留一些正在生长的想法。
				</p>
			</div>
			<div class="flex shrink-0 flex-wrap gap-3">
				<a href={url("/blog/")} class="rounded-md bg-white px-4 py-2 text-sm font-medium text-black transition hover:bg-white/85">
					阅读博客
				</a>
				<a href={url("/tools/")} class="rounded-md border border-white/12 px-4 py-2 text-sm font-medium text-white/82 transition hover:bg-white/[0.07] hover:text-white">
					探索工具
				</a>
			</div>
		</div>
	</section>

	<section class="grid gap-10 border-b border-white/10 py-14 lg:grid-cols-[0.9fr_1.1fr]">
		<div>
			<p class="text-sm font-medium text-white/45">About</p>
			<h2 class="mt-3 text-2xl font-semibold text-white">关于我</h2>
		</div>
		<div class="space-y-5 text-sm leading-7 text-white/62">
			<p>
				我把这个站点当作自己的知识栈：一些问题会从笔记开始，经过实验、复盘和工具化，最后沉淀成可复用的经验。
			</p>
			<p>
				如果你也关心技术、创作自动化、个人系统和独立站，这里会陆续整理可阅读、可使用、也可追踪的内容。
			</p>
		</div>
	</section>

	<section class="space-y-6 border-b border-white/10 py-14">
		<div>
			<p class="text-sm font-medium text-white/45">Explore</p>
			<h2 class="mt-3 text-2xl font-semibold text-white">从这里开始</h2>
		</div>
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{entryLinks.map((item) => (
				<a href={url(item.href)} class="group min-h-40 rounded-lg border border-white/10 bg-[var(--card-bg)] p-5 transition hover:border-white/28 hover:bg-white/[0.05]">
					<Icon name={item.icon} class="text-2xl text-white/45 transition group-hover:text-white/80" />
					<h3 class="mt-5 font-medium text-white/90">{item.title}</h3>
					<p class="mt-2 text-sm leading-6 text-white/52">{item.description}</p>
				</a>
			))}
		</div>
	</section>

	<section class="grid gap-10 border-b border-white/10 py-14 lg:grid-cols-[0.9fr_1.1fr]">
		<div>
			<p class="text-sm font-medium text-white/45">Latest</p>
			<h2 class="mt-3 text-2xl font-semibold text-white">最近内容</h2>
		</div>
		<div class="overflow-hidden rounded-lg border border-white/10">
			{posts.map((entry) => (
				<a href={getPostUrlBySlug(entry.id)} class="block border-b border-white/10 p-5 transition last:border-b-0 hover:bg-white/[0.05]">
					<div class="text-xs text-white/42">{entry.data.published.toISOString().slice(0, 10)}</div>
					<h3 class="mt-2 font-semibold text-white/90">{entry.data.title}</h3>
					<p class="mt-2 line-clamp-2 text-sm leading-6 text-white/55">{entry.data.description}</p>
				</a>
			))}
		</div>
	</section>

	<section class="space-y-6 py-14">
		<div>
			<p class="text-sm font-medium text-white/45">Links</p>
			<h2 class="mt-3 text-2xl font-semibold text-white">站点与账号</h2>
		</div>
		<div class="grid gap-4 sm:grid-cols-3">
			{externalLinks.map((item) => (
				<a
					href={item.href.startsWith("/") ? url(item.href) : item.href}
					target={item.href.startsWith("/") ? null : "_blank"}
					rel={item.href.startsWith("/") ? null : "noopener noreferrer"}
					class="group rounded-lg border border-white/10 bg-[var(--card-bg)] p-5 transition hover:border-white/28 hover:bg-white/[0.05]"
				>
					<div class="flex items-center gap-2">
						<Icon name={item.icon} class="text-xl text-white/45 transition group-hover:text-white/80" />
						<h3 class="font-medium text-white/90">{item.title}</h3>
					</div>
					<p class="mt-2 text-sm leading-6 text-white/52">{item.description}</p>
				</a>
			))}
		</div>
	</section>
</SiteShellLayout>
