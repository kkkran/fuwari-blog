---
import Icon from "@components/Icon.astro";
import SiteShellLayout from "@layouts/SiteShellLayout.astro";
import { profileConfig, serviceConfig, siteConfig } from "../config";
import { url } from "../utils/url-utils";

const exploreLinks = [
	{
		title: "阅读博客",
		description: "技术笔记、AI 工作流、工具实验和长期写作。",
		href: "/blog/",
		icon: "material-symbols:article-outline-rounded",
	},
	{
		title: "AI 生图",
		description: "浏览图像收藏和创作相关工具。",
		href: "/tools/gallery/",
		icon: "material-symbols:palette-outline-rounded",
	},
	{
		title: "实用工具",
		description: "封面生成、文件、短链与日常小工具。",
		href: "/tools/",
		icon: "material-symbols:business-center-outline-rounded",
	},
	{
		title: "朋友们",
		description: "站点友链与我常访问的角落。",
		href: "/friends/",
		icon: "material-symbols:link-rounded",
	},
];

const toolLinks = [
	{
		title: "封面制作",
		description: "一键生成文章与社交媒体封面。",
		href: "/tools/cover/",
		icon: "material-symbols:image-outline-rounded",
	},
	{
		title: "文件浏览",
		description: "查看与分享站点托管的文件。",
		href: "/tools/files/",
		icon: "material-symbols:folder-open-outline-rounded",
	},
	{
		title: "长链接",
		description: "把长网址压缩为短链接。",
		href: "/tools/long-link/",
		icon: "material-symbols:link-rounded",
	},
];

const socialLinks = [
	{
		title: "GitHub",
		href: "https://github.com/kkkran",
		icon: "simple-icons:github",
	},
	{
		title: "Bilibili",
		href: "https://space.bilibili.com/500929752",
		icon: "simple-icons:bilibili",
	},
	{
		title: "RSS",
		href: "/rss.xml",
		icon: "material-symbols:rss-feed-rounded",
	},
	{
		title: "站点状态",
		href: `${serviceConfig.umamiBaseUrl}/share/CdkXbGgZr6ECKOyK`,
		icon: "material-symbols:monitor-heart-outline-rounded",
	},
];
---

<SiteShellLayout title="首页" description={siteConfig.description}>
	<!-- Hero -->
	<section class="relative flex min-h-[calc(100vh-56px)] flex-col items-center justify-center px-4 py-24 text-center">
		<img
			src={profileConfig.avatar}
			alt={siteConfig.title}
			width="112"
			height="112"
			class="h-28 w-28 rounded-full object-cover"
		/>
		<p class="mt-5 rounded-full border border-[var(--border)]/60 px-2 py-0.5 text-[11px] text-[var(--muted-foreground)]">
			{siteConfig.subtitle}
		</p>
		<h1 class="mt-5 max-w-3xl text-center text-3xl font-bold tracking-tight sm:text-4xl">
			{siteConfig.title}
		</h1>
		<p class="mt-5 max-w-2xl text-center text-base leading-relaxed text-[var(--muted-foreground)]">
			{siteConfig.description}
		</p>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
			<a
				href={url("/blog/")}
				class="flex h-9 items-center gap-2 rounded-lg bg-[var(--primary)] px-4 text-sm font-medium text-[var(--primary-foreground)] transition-colors hover:bg-[var(--foreground)]/90"
			>
				阅读博客
			</a>
			<a
				href={url("/tools/")}
				class="flex h-9 items-center gap-2 rounded-lg border border-[var(--input)] bg-[var(--background)] px-4 text-sm font-medium text-[var(--foreground)] transition-colors hover:bg-[var(--accent)]"
			>
				探索工具
			</a>
		</div>
	</section>

	<!-- 探索我在做什么 -->
	<section class="px-4 py-24">
		<div class="mx-auto max-w-6xl">
			<h2 class="text-3xl font-bold tracking-tight">探索我在做什么</h2>
			<p class="mt-3 text-[var(--muted-foreground)]">
				从技术博客到 AI 创作工具，这里是我的数字花园。
			</p>
			<div class="mt-8 grid grid-cols-1 gap-px border-y border-[var(--border)] bg-[var(--border)] sm:grid-cols-2 sm:border lg:grid-cols-4">
				{exploreLinks.map((item) => (
					<a
						href={url(item.href)}
						class="group flex items-start justify-between gap-4 bg-[var(--background)] p-6 transition-colors hover:bg-[var(--card)]"
					>
						<div>
							<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--primary)]/10 text-[var(--primary)]">
								<Icon name={item.icon} class="size-5" />
							</div>
							<h3 class="mt-5 font-medium">{item.title}</h3>
							<p class="mt-2 text-sm leading-6 text-[var(--muted-foreground)]">
								{item.description}
							</p>
						</div>
						<Icon
							name="material-symbols:arrow-forward-rounded"
							class="mt-2 size-4 shrink-0 text-[var(--muted-foreground)] transition group-hover:translate-x-0.5"
						/>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- 关于我 -->
	<section class="border-t border-[var(--border)]/40 px-4 py-24">
		<div class="mx-auto max-w-3xl">
			<h2 class="text-3xl font-bold tracking-tight">关于我</h2>
			<div class="mt-5 space-y-5 text-base leading-relaxed text-[var(--muted-foreground)]">
				<p>
					我把这个站点当作自己的知识栈：一些问题会从笔记开始，经过实验、复盘和工具化，最后沉淀成可复用的经验。
				</p>
				<p>
					如果你也关心技术、创作自动化、个人系统和独立站，这里会陆续整理可阅读、可使用、也可追踪的内容。
				</p>
			</div>
		</div>
	</section>

	<!-- 实用工具集 -->
	<section class="border-t border-[var(--border)]/40 px-4 py-24">
		<div class="mx-auto max-w-6xl">
			<h2 class="text-3xl font-bold tracking-tight">实用工具集</h2>
			<p class="mt-3 text-[var(--muted-foreground)]">
				日常开发与创作的副产品，开放给有需要的人使用。
			</p>
			<div class="mt-8 grid grid-cols-1 gap-px border-y border-[var(--border)] bg-[var(--border)] sm:grid-cols-2 sm:border lg:grid-cols-3">
				{toolLinks.map((item) => (
					<a
						href={url(item.href)}
						class="group flex items-start justify-between gap-4 bg-[var(--background)] p-6 transition-colors hover:bg-[var(--card)]"
					>
						<div>
							<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--primary)]/10 text-[var(--primary)]">
								<Icon name={item.icon} class="size-5" />
							</div>
							<h3 class="mt-5 font-medium">{item.title}</h3>
							<p class="mt-2 text-sm leading-6 text-[var(--muted-foreground)]">
								{item.description}
							</p>
						</div>
						<Icon
							name="material-symbols:arrow-forward-rounded"
							class="mt-2 size-4 shrink-0 text-[var(--muted-foreground)] transition group-hover:translate-x-0.5"
						/>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- 关注联系 -->
	<section class="border-t border-[var(--border)]/40 px-4 py-24">
		<div class="mx-auto max-w-6xl">
			<div class="flex flex-col items-center gap-6 text-center">
				<h2 class="text-3xl font-bold tracking-tight">在这些平台上找到我</h2>
				<div class="flex flex-wrap items-center justify-center gap-3">
					{socialLinks.map((item) => (
						<a
							href={url(item.href)}
							target={item.href.startsWith("http") ? "_blank" : null}
							rel={item.href.startsWith("http") ? "noopener noreferrer" : null}
							aria-label={item.title}
							title={item.title}
							class="flex size-11 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--card)] text-[var(--muted-foreground)] transition-colors hover:bg-[var(--foreground)] hover:text-[var(--background)]"
						>
							<Icon name={item.icon} class="size-5" />
						</a>
					))}
				</div>
			</div>
		</div>
	</section>
</SiteShellLayout>
