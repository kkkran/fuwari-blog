---
import Icon from "@components/Icon.astro";
import PostPage from "../../components/PostPage.astro";
import Pagination from "../../components/control/Pagination.astro";
import Search from "../../components/Search.svelte";
import { siteConfig } from "../../config";
import { PAGE_SIZE } from "../../constants/constants";
import SiteShellLayout from "../../layouts/SiteShellLayout.astro";
import { getSortedPosts } from "../../utils/content-utils";
import { fetchDbPostsAll, toCollectionEntry } from "../../utils/blog-db";
import { url } from "../../utils/url-utils";

// 混合数据源：md 文章（content collection）+ 数据库文章（后端），运行时实时合并
export const prerender = false;

const allBlogPosts = await getSortedPosts();
// 后端不可用时降级为纯 md 文章
const dbPosts = (await fetchDbPostsAll()).map(toCollectionEntry);

const merged = [...dbPosts, ...allBlogPosts].sort(
	(a, b) => b.data.published.getTime() - a.data.published.getTime(),
);

const paramPage = Astro.params.page ? Number(Astro.params.page) : 1;
const currentPage = Number.isFinite(paramPage) && paramPage > 0 ? paramPage : 1;
const totalPages = Math.max(1, Math.ceil(merged.length / PAGE_SIZE));
const pageItems = merged.slice(
	(currentPage - 1) * PAGE_SIZE,
	currentPage * PAGE_SIZE,
);

const page = {
	data: pageItems,
	currentPage,
	lastPage: totalPages,
	total: merged.length,
	size: PAGE_SIZE,
	start: (currentPage - 1) * PAGE_SIZE + 1,
	end: (currentPage - 1) * PAGE_SIZE + pageItems.length,
	url: {
		prev:
			currentPage > 1
				? currentPage === 2
					? "/blog/"
					: `/blog/${currentPage - 1}/`
				: undefined,
		next: currentPage < totalPages ? `/blog/${currentPage + 1}/` : undefined,
		current: currentPage === 1 ? "/blog/" : `/blog/${currentPage}/`,
		first: "/blog/",
		last: `/blog/${totalPages}/`,
	},
};

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Blog",
	name: `${siteConfig.title}博客`,
	url: new URL("/blog/", Astro.site).toString(),
	description: siteConfig.description,
};
---

<SiteShellLayout title={page.currentPage === 1 ? "博客" : `博客 第 ${page.currentPage} 页`}>
	{page.currentPage === 1 && (
		<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
	)}

	<section class="py-6 sm:py-8">
		<div class="mb-6 flex items-center justify-between gap-4">
			<h1 class="text-2xl font-bold tracking-tight text-[var(--foreground)]">博客</h1>
			<a
				href={url("/rss.xml")}
				class="inline-flex items-center gap-1.5 border border-[var(--border)] bg-[var(--card)] px-3 py-1.5 text-sm text-[var(--muted-foreground)] transition-colors hover:bg-[var(--accent)] hover:text-[var(--foreground)]"
			>
				<Icon name="material-symbols:rss-feed-rounded" class="text-[1rem]" />
				<span aria-hidden="true">RSS</span>
			</a>
		</div>

		<div class="mb-8">
			<Search client:idle variant="wide" />
		</div>

		<PostPage page={page}></PostPage>
		<Pagination class="mx-auto mt-8" page={page} sort="blog"></Pagination>
	</section>
</SiteShellLayout>
