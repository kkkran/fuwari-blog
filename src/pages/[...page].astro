---
import type { GetStaticPaths } from "astro";
import PostPage from "../components/PostPage.astro";
import Pagination from "../components/control/Pagination.astro";
import PostSort from "../components/control/PostSort.astro";
import { siteConfig } from "../config";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// 准备当前页文章数据供客户端排序使用
const pagePostsData = page.data.map(entry => {
	const data = entry.data as {
		title: string;
		published: Date;
		pinned?: boolean;
	};
	return {
		id: entry.id,
		title: data.title,
		published: data.published.toISOString(),
		pinned: data.pinned,
	};
});

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: siteConfig.title,
	url: Astro.site,
	description: siteConfig.description,
};
---

<MainGridLayout title={page.currentPage === 1 ? undefined : `第 ${page.currentPage} 页`}>
    {page.currentPage === 1 && <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
    <div slot="before-content">
        {page.currentPage === 1 && (
            <section class="card-base mb-4 overflow-hidden p-6 md:p-8">
                <div class="grid gap-6 md:grid-cols-[1.5fr_0.8fr] md:items-end">
                    <div>
                        <div class="mb-4 text-xs uppercase tracking-[0.2em] text-white/35">Shijie’s Nook</div>
                        <h1 class="max-w-[11ch] text-4xl font-bold leading-none text-white md:text-5xl">{siteConfig.title}</h1>
                        <p class="mt-5 max-w-[48rem] text-base leading-relaxed text-white/58">
                            这里收纳技术笔记、AI 工作流、工具实验和一些长期维护的生活化记录。内容按时间生长，偶尔分叉，最后归入自己的知识栈。
                        </p>
                    </div>
                    <div class="grid grid-cols-2 gap-3 text-sm">
                        <a href="/archive/" class="rounded-lg border border-white/10 bg-white/[0.035] p-4 text-white/70 transition hover:border-[var(--primary)] hover:text-[var(--primary)] active:scale-[0.99]">
                            <div class="text-2xl font-bold text-white/90">{page.data.length}</div>
                            <div class="mt-1 text-white/40">本页文章</div>
                        </a>
                        <a href="/tools/" class="rounded-lg border border-white/10 bg-white/[0.035] p-4 text-white/70 transition hover:border-[var(--primary)] hover:text-[var(--primary)] active:scale-[0.99]">
                            <div class="text-2xl font-bold text-white/90">Lab</div>
                            <div class="mt-1 text-white/40">工具实验</div>
                        </a>
                    </div>
                </div>
            </section>
        )}
        <PostSort></PostSort>
    </div>
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto" page={page}></Pagination>
	<script define:vars={{ pagePostsData }}>
		window.__PAGE_POSTS_DATA__ = pagePostsData;
	</script>
	<script src="../scripts/post-list-sort.ts"></script>
</MainGridLayout>
