---
import { serviceConfig } from "@/config";
import type { SponsorEntry, SponsorStats } from "@/blog/api";
import SponsorForm from "@components/SponsorForm.svelte";
import SiteShellLayout from "@layouts/SiteShellLayout.astro";
import Icon from "@components/Icon.astro";

// 名单数据来自后端 API（审核通过即时生效），页面必须动态渲染而非构建时预渲染
export const prerender = false;

const apiBase = serviceConfig.blogApiBaseUrl;

// SSR 拉取已通过名单与统计；服务不可用时兜底为空列表
let sponsors: SponsorEntry[] = [];
let stats: SponsorStats = { count: 0, amount: 0 };
try {
	const [listRes, statsRes] = await Promise.all([
		fetch(`${apiBase}/api/sponsors`),
		fetch(`${apiBase}/api/sponsors/stats`),
	]);
	if (listRes.ok) {
		sponsors = ((await listRes.json()) as { sponsors: SponsorEntry[] }).sponsors ?? [];
	}
	if (statsRes.ok) {
		stats = (await statsRes.json()) as SponsorStats;
	}
} catch (error) {
	// 后端不可用时页面照常渲染，名单区域显示空态
	console.error("[sponsors] 后端不可用，名单显示为空:", error);
}

function formatAmount(value: number): string {
	return Number.isInteger(value) ? String(value) : value.toFixed(2);
}

const medals = ["🥇", "🥈", "🥉"];

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "首页",
			item: Astro.site,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "赞助支持",
			item: new URL("/sponsors", Astro.site).toString(),
		},
	],
};
---

<SiteShellLayout title="赞助支持">
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbSchema)}
	></script>
	<section class="py-8">
		<h1 class="text-2xl font-bold tracking-tight">赞助支持</h1>
		<p class="mt-2 max-w-2xl text-sm text-[var(--muted-foreground)]">
			如果您觉得我的内容对您有帮助，欢迎通过以下方式支持我的创作。您的每一份支持都是我持续创作的动力！
		</p>
		<p class="mt-1 text-sm text-[var(--muted-foreground)]">
			所有赞助将用于网站维护、服务器费用以及内容创作。
		</p>

		<!-- 支付方式 -->
		<div class="mb-12 mt-8 border-y border-[var(--border)] py-8">
			<div class="grid grid-cols-1 gap-8 md:grid-cols-2">
				<!-- 支付宝 -->
				<div>
					<div class="mb-4 flex items-center gap-3">
						<div class="flex h-10 w-10 items-center justify-center bg-blue-500">
							<Icon name="simple-icons:alipay" class="text-[1.5rem] text-white" />
						</div>
						<div>
							<h3 class="text-lg font-bold">支付宝</h3>
							<p class="text-sm text-[var(--muted-foreground)]">扫码支付</p>
						</div>
					</div>
					<div class="inline-block border border-[var(--border)] bg-[var(--card)] p-4">
						<img
							src="/sponsors/alipay.png"
							alt="支付宝收款码"
							class="h-64 w-auto max-w-full object-contain"
						/>
					</div>
					<p class="mt-3 text-sm text-[var(--muted-foreground)]">
						保存图片到相册，用<span class="font-semibold text-[var(--primary)]">支付宝</span>扫一扫
					</p>
				</div>

				<!-- 微信支付 -->
				<div>
					<div class="mb-4 flex items-center gap-3">
						<div class="flex h-10 w-10 items-center justify-center bg-green-500">
							<Icon name="simple-icons:wechat" class="text-[1.5rem] text-white" />
						</div>
						<div>
							<h3 class="text-lg font-bold">微信支付</h3>
							<p class="text-sm text-[var(--muted-foreground)]">扫码支付</p>
						</div>
					</div>
					<div class="inline-block border border-[var(--border)] bg-[var(--card)] p-4">
						<img
							src="/sponsors/wechat.png"
							alt="微信打赏码"
							class="h-64 w-auto max-w-full object-contain"
						/>
					</div>
					<p class="mt-3 text-sm text-[var(--muted-foreground)]">
						保存图片到相册，用<span class="font-semibold text-[var(--primary)]">微信</span>扫一扫
					</p>
				</div>
			</div>
			<p class="mt-8 text-center text-sm text-[var(--muted-foreground)]">
				打赏后可在下方登记你的名字，感谢每一份支持 ❤️
			</p>
		</div>

		<!-- 已赞助的小伙伴 -->
		<div class="sponsors-section">
			<h2 class="mb-1 flex items-center gap-2 text-xl font-bold">
				<Icon name="material-symbols:group" class="text-[1.5rem] text-[var(--primary)]"></Icon>
				<span>已赞助的小伙伴</span>
			</h2>
			<p class="mb-4 text-sm text-[var(--muted-foreground)]">
				感谢每一位支持者，让这个站点可以继续运转。
			</p>

			<SponsorForm client:load />

			<div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 rounded-xl border border-[var(--border)] bg-[var(--card)] px-4 py-3 text-sm">
				<span class="font-semibold text-[var(--primary)]">
					共 {stats.count} 位赞助者
				</span>
				<span class="text-[var(--muted-foreground)]">
					累计赞助 ¥{formatAmount(stats.amount)}
				</span>
				<span class="text-xs text-[var(--muted-foreground)]">
					（仅统计人民币金额，历史特殊币种不计入累计）
				</span>
			</div>

			{sponsors.length > 0 ? (
				<div class="mt-4 grid grid-cols-1 border-t border-l border-[var(--border)] sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
					{sponsors.map((sponsor, index) => (
						<div class="flex items-center gap-3 border-b border-r border-[var(--border)] bg-[var(--background)] p-3">
							{sponsor.avatarUrl ? (
								<img
									src={sponsor.avatarUrl}
									alt={`${sponsor.displayName}的头像`}
									loading="lazy"
									class="h-10 w-10 shrink-0 rounded-full object-cover"
								/>
							) : (
								<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--card)] text-sm font-bold text-[var(--primary)]">
									{sponsor.displayName.slice(0, 1)}
								</div>
							)}
							<div class="min-w-0 flex-1">
								<h4 class="truncate text-sm font-semibold">
									{index < 3 ? `${medals[index]} ${sponsor.displayName}` : sponsor.displayName}
								</h4>
								<p class="text-xs text-[var(--muted-foreground)]">{sponsor.date}</p>
							</div>
							<div class="text-xs font-medium text-[var(--primary)]">
								{sponsor.amountText}
							</div>
						</div>
					))}
				</div>
			) : (
				<p class="mt-4 rounded-xl border border-dashed border-[var(--border)] p-6 text-center text-sm text-[var(--muted-foreground)]">
					还没有赞助记录，成为第一个支持者吧！
				</p>
			)}
		</div>
	</section>
</SiteShellLayout>

<style>
	.sponsors-section {
		@apply mt-6;
	}
</style>
