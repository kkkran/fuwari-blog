---
import { siteConfig } from "@/config";
import type { Friend } from "@/types/data";
import LinkSubmitInfo from "@components/misc/LinkSubmitInfo.astro";
import SiteShellLayout from "@layouts/SiteShellLayout.astro";
import Icon from "@components/Icon.astro";

const friends = Object.values(
	import.meta.glob<Friend>("@/data/friends/*.json", {
		eager: true,
		import: "default",
	}),
);

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "首页",
			item: Astro.site,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "友链",
			item: new URL("/friends", Astro.site).toString(),
		},
	],
};
---

<SiteShellLayout title="友链">
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(breadcrumbSchema)}
	></script>
	<section class="py-8">
		<h1 class="text-2xl font-bold tracking-tight">友链</h1>
		<p class="mt-2 text-sm text-[var(--muted-foreground)]">
			与志同道合的创作者互换友链；如果这里的内容帮到了你，欢迎考虑赞助支持。
		</p>

		<div class="mt-6">
			<LinkSubmitInfo dataType="friends"></LinkSubmitInfo>
		</div>

		<div class="mt-8 grid grid-cols-1 border-t border-l border-[var(--border)] md:grid-cols-2 lg:grid-cols-3">
			{friends.map((friend) => (
				<a
					href={friend.url}
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-4 border-b border-r border-[var(--border)] bg-[var(--background)] p-4 transition-colors hover:bg-[var(--card)]"
				>
					<img
						src={friend.avatar}
						alt={`${friend.name}的头像`}
						loading="lazy"
						class="h-16 w-16 shrink-0 rounded-full object-cover"
					/>
					<div class="min-w-0">
						<div class="flex items-center gap-2">
							<span class="truncate font-semibold">{friend.name}</span>
						</div>
						<p class="mt-1 line-clamp-2 text-sm text-[var(--muted-foreground)]">
							{friend.description}
						</p>
					</div>
				</a>
			))}
		</div>
	</section>
</SiteShellLayout>
