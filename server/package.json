{
	"name": "fuwari-blog-server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "博客后端服务：自建账号 + GitHub OAuth 登录，博客文章存储于 SQLite，提供提交/审核/通知 API。",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"test": "tsx --test test/*.test.ts",
		"type-check": "tsc --noEmit",
		"build": "tsc"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"better-sqlite3": "^11.10.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^17.3.1",
		"express": "^4.21.2",
		"multer": "^2.2.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/cookie-parser": "^1.4.9",
		"@types/cors": "^2.8.19",
		"@types/express": "^4.17.23",
		"@types/multer": "^2.2.0",
		"@types/node": "^22.15.0",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3"
	}
}
