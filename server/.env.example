# 服务端口
PORT=3001

# 会话
SESSION_COOKIE_NAME=fuwari_session
SESSION_TTL_DAYS=30

# 管理员邮箱（逗号分隔，注册/GitHub 登录时命中即为 admin）
ADMIN_EMAILS=admin@example.com

# GitHub OAuth（留空则隐藏 GitHub 登录按钮）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:3001/api/auth/github/callback

# 前端地址（登录/注册成功后回跳、OAuth 回调落地页）
FRONTEND_BASE_URL=http://127.0.0.1:4321

# CORS 允许来源（逗号分隔）
CORS_ORIGIN=http://127.0.0.1:4321

# SQLite 数据库文件路径
DATABASE_PATH=./data/fuwari.db
